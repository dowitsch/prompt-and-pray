# HOMEWARD — agent brain configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
# Every variable here is read on the SERVER ONLY. None of them are prefixed
# with PUBLIC_/VITE_, so SvelteKit cannot leak them into the browser bundle.
#
# The game is fully playable with this file absent — it falls back to the
# deterministic offline brain. See docs/ai-integration.md.

# mock   = deterministic offline brain, no network, no key (default)
# apertus = any OpenAI-compatible /chat/completions endpoint
AI_PROVIDER=mock

# --- Apertus v1.5 8B (Stoney Cloud) ------------------------------------
# AI_PROVIDER=apertus
# AI_BASE_URL=https://llm.stoney-cloud.com/v1/chat/completions
# AI_MODEL=apertus-ai/Apertus-v1.5-8B
# AI_API_KEY=sk-...

# --- Apertus v1.5 70B (onprem.ai) --------------------------------------
# Better instruction-following, but keep AI_JSON_MODE=false: this endpoint's
# json_object mode emits a doubled opening brace, which is not valid JSON.
# Without it the model returns clean JSON on its own.
# AI_PROVIDER=apertus
# AI_BASE_URL=https://llm-api2.b.onprem.ai/openai/v1/chat/completions
# AI_MODEL=apertus-v1.5-70b
# AI_API_KEY=sk-...
# AI_JSON_MODE=false

# --- Reading the tale aloud (ElevenLabs) --------------------------------
# With a key, the tale is read out by a cast of five: a narrator for the world's
# own lines, and one voice each for Krotz, Aurelia, PENGU-01 and Malakor. Without
# one, the switch still works and the browser's own voices read it instead —
# worse, free, and always there.
#
# Note what turning it on does to the pace: the runner holds each line until the
# phones reading it aloud say they have finished, so a match with a voice on takes
# as long as the sentences take. That is the feature, not a side effect.
# ELEVENLABS_API_KEY=sk_...
#
# eleven_flash_v2_5 is the low-latency model, and the audio is only fetched once
# the line is already on screen. eleven_multilingual_v2 sounds better and waits.
# ELEVENLABS_MODEL=eleven_flash_v2_5
#
# Recasting. Each defaults to one of ElevenLabs' premade voices, chosen to be
# told apart rather than admired — you should be able to hear which agent is
# talking without looking up from the map. Any of them can be replaced with a
# voice id from your own library.
# ELEVENLABS_VOICE_NARRATOR=   # George, warm captivating storyteller
# ELEVENLABS_VOICE_KROTZ=      # Callum, husky trickster
# ELEVENLABS_VOICE_AURELIA=    # Alice, clear and precise
# ELEVENLABS_VOICE_PENGU=      # Charlie, young and hyped
# ELEVENLABS_VOICE_MALAKOR=    # Bill, old and wise
#
# Per-line timeout. On expiry the phone falls back to its own voices for that one
# line, so a slow provider costs a worse sentence and never a stalled match.
# ELEVENLABS_TIMEOUT_MS=8000
#
# The longest a beat will wait for a phone to say it has finished reading. A
# ceiling, not a duration: it is only ever reached by a phone that stopped
# answering — a closed tab, a backgrounded one, a dead network. The same
# discipline as the teaching window's deadline. The tale never waits forever.
# SPEECH_CEILING_MS=30000

# --- Empty chairs -------------------------------------------------------
# How long a match waits for somebody whose socket dropped. A phone in a tunnel,
# a locked screen and a page refresh all look identical from here, and the client
# retries for about two minutes, so this is deliberately generous.
#
# Past it the absence is treated as real: the seat is taken over by a simulated
# operator, or dropped if the match has not started yet — and a match with nobody
# left at it is shut down. Leaving through the menu does not wait for this; that
# is somebody saying so.
# ABSENCE_GRACE_MS=90000

# --- Pace ---------------------------------------------------------------
# How slowly each round is told. Every beat — arriving somewhere, reading what
# the agent remembers, the choice, the epitaph — is multiplied by this.
#   1     the tuned default
#   1.5   a leisurely read-aloud pace
#   0.6   brisk, if you just want to see the outcome
# PACE_SCALE=1

# --- The four characters ------------------------------------------------
# Krotz, Aurelia, PENGU-01 and Malakor each get their own block of the system
# prompt and their own sampling parameters (src/lib/agent/personas.ts), so two
# agents at the same crossroads with the same notes genuinely decide
# differently. Turn this off to run all four on the baselines below instead —
# useful for an A/B, and the dial to reach for if the spread is too wide.
# AI_PERSONAS=on

# --- Optional tuning ----------------------------------------------------
# These are BASELINES. Each character's persona overrides the ones it cares
# about and inherits the rest; with AI_PERSONAS=off they are the whole story.
#
# Send response_format={"type":"json_object"}. Supported by vLLM servers
# (the 8B endpoint); harmless to turn off if a provider rejects it.
# AI_JSON_MODE=true
# AI_TEMPERATURE=0.8
# AI_MAX_TOKENS=160
# Left unset by default: no top_p or penalty is sent unless a persona asks for
# one, or you set one here.
# AI_TOP_P=
# AI_FREQUENCY_PENALTY=
# AI_PRESENCE_PENALTY=
# Per-decision timeout in ms; on timeout the agent falls back to the mock brain.
# AI_TIMEOUT_MS=8000
# Max provider calls in flight across all four agents.
# AI_CONCURRENCY=4

# Where the SQLite database lives. Defaults to ./data/homeward.db; on Fly it is
# /data/homeward.db, on the volume. The schema is migrated and the built-in
# stories seeded on boot, so a fresh path just works.
# DATABASE_PATH=./data/homeward.db

# The story designer at /design. It shows every answer and there is no login, so
# it is on in development and off in production unless you say otherwise. Turn it
# on for an instance you author on; leave it off for one people play on.
# DESIGNER=on
